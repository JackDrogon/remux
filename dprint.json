{
  "toml": {
    "useTabs": false,
    "cargo.applyConventions": false,
    "indentWidth": 4
  },
  "json": {
    "indentWidth": 2
  },
  "markdown": {
    "lineWidth": 100,
    "textWrap": "always"
  },
  "includes": [
    "**/*.{json,md,toml,yml,yaml}"
  ],
  "excludes": [
    "target/**/*"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.0.wasm",
    "https://plugins.dprint.dev/markdown-0.18.0.wasm",
    "https://plugins.dprint.dev/toml-0.6.4.wasm"
  ]
}
